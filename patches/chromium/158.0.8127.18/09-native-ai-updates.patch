 void DevToolsUIBindings::OpenInNewTab(const std::string& url) {
   GURL gurl(url);
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_UPDATER)
+  // The shipped Browser Operator panel may open only the fixed native update
+  // page. Remote/custom frontends and all other chrome:// URLs retain the
+  // standard request policy below.
+  if (is_local_frontend_ && !profile_->IsSystemProfile() && web_contents_ &&
+      gurl == GURL(chrome::kChromeUIHelpURL)) {
+    const GURL& frontend = web_contents_->GetLastCommittedURL();
+    if (frontend.SchemeIs(content::kChromeDevToolsScheme) &&
+        frontend.host() == "devtools" &&
+        base::StartsWith(frontend.path(), "/bundled/")) {
+      // This fixed browser command is independent of the inspected page.
+      // Generic OpenInNewTab also applies its security policy downstream and
+      // correctly blocks privileged URLs attributed to web content.
+      Profile* update_profile = profile_->IsGuestSession()
+                                    ? profile_
+                                    : profile_->GetOriginalProfile();
+      chrome::ScopedTabbedBrowserDisplayer displayer(update_profile);
+      if (auto* browser = displayer.browser_window_interface()) {
+        chrome::ShowAboutChrome(browser);
+      }
+      return;
+    }
+  }
+#endif
   // Hardening: Verify that the frontend renderer is allowed to request this URL.
   content::ChildProcessSecurityPolicy* policy =
       content::ChildProcessSecurityPolicy::GetInstance();
@@ -2359,7 +2386,20 @@ base::DictValue DevToolsUIBindings::GetHostConfigDictionary(Profile* profile) {
 }
 
 void DevToolsUIBindings::GetHostConfig(DispatchCallback callback) {
-  base::Value response(GetHostConfigDictionary(profile_));
+  base::DictValue config = GetHostConfigDictionary(profile_);
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_UPDATER)
+  if (is_local_frontend_ && !profile_->IsSystemProfile() && web_contents_) {
+    const GURL& frontend = web_contents_->GetLastCommittedURL();
+    if (frontend.SchemeIs(content::kChromeDevToolsScheme) &&
+        frontend.host() == "devtools" &&
+        base::StartsWith(frontend.path(), "/bundled/")) {
+      base::DictValue browser_operator_updates;
+      browser_operator_updates.Set("enabled", true);
+      config.Set("browserOperatorUpdates", std::move(browser_operator_updates));
+    }
+  }
+#endif
+  base::Value response(std::move(config));
   std::move(callback).Run(&response);
 }
 
