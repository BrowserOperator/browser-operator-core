         std::make_unique<DevToolsDataSource>(
             std::move(factory), chrome::kChromeUIDevToolsRemoteHost));
   }
+  // Allow DevTools UI (devtools://devtools) to make CORS requests to
+  // all HTTPS hosts, localhost (HTTP/HTTPS), and loopback addresses.
+  {
+    const url::Origin source =
+        url::Origin::Create(GURL("devtools://devtools"));
+    std::vector<network::mojom::CorsOriginPatternPtr> allow_patterns;
+
+    // Allow all hosts for https on any port.
+    constexpr uint16_t kAnyPort = 0;
+    allow_patterns.push_back(network::mojom::CorsOriginPattern::New(
+        /*protocol=*/"https",
+        /*domain=*/"",
+        /*port=*/kAnyPort,
+        network::mojom::CorsDomainMatchMode::kAllowSubdomains,
+        network::mojom::CorsPortMatchMode::kAllowAnyPort,
+        network::mojom::CorsOriginAccessMatchPriority::kDefaultPriority));
+
+    // mcp.atlassian.com:443 (HTTPS)
+    allow_patterns.push_back(network::mojom::CorsOriginPattern::New(
+        /*protocol=*/"https",
+        /*domain=*/"mcp.atlassian.com",
+        /*port=*/443,
+        network::mojom::CorsDomainMatchMode::kDisallowSubdomains,
+        network::mojom::CorsPortMatchMode::kAllowOnlySpecifiedPort,
+        network::mojom::CorsOriginAccessMatchPriority::kDefaultPriority));
+
+    // localhost (any port) — HTTP
+    allow_patterns.push_back(network::mojom::CorsOriginPattern::New(
+        /*protocol=*/"http",
+        /*domain=*/"localhost",
+        /*port=*/kAnyPort,
+        network::mojom::CorsDomainMatchMode::kAllowSubdomains,
+        network::mojom::CorsPortMatchMode::kAllowAnyPort,
+        network::mojom::CorsOriginAccessMatchPriority::kDefaultPriority));
+
+    // localhost (any port) — HTTPS
+    allow_patterns.push_back(network::mojom::CorsOriginPattern::New(
+        /*protocol=*/"https",
+        /*domain=*/"localhost",
+        /*port=*/kAnyPort,
+        network::mojom::CorsDomainMatchMode::kAllowSubdomains,
+        network::mojom::CorsPortMatchMode::kAllowAnyPort,
+        network::mojom::CorsOriginAccessMatchPriority::kDefaultPriority));
+
+    // 127.0.0.1 (any port) — HTTPS only
+    allow_patterns.push_back(network::mojom::CorsOriginPattern::New(
+        /*protocol=*/"https",
+        /*domain=*/"127.0.0.1",
+        /*port=*/kAnyPort,
+        network::mojom::CorsDomainMatchMode::kDisallowSubdomains,
+        network::mojom::CorsPortMatchMode::kAllowAnyPort,
+        network::mojom::CorsOriginAccessMatchPriority::kDefaultPriority));
+
+    // ::1 (any port) — HTTPS only
+    allow_patterns.push_back(network::mojom::CorsOriginPattern::New(
+        /*protocol=*/"https",
+        /*domain=*/"::1",
+        /*port=*/kAnyPort,
+        network::mojom::CorsDomainMatchMode::kDisallowSubdomains,
+        network::mojom::CorsPortMatchMode::kAllowAnyPort,
+        network::mojom::CorsOriginAccessMatchPriority::kDefaultPriority));
+
+    std::vector<network::mojom::CorsOriginPatternPtr> block_patterns;
+    content::CorsOriginPatternSetter::Set(browser_context, source,
+                                          std::move(allow_patterns),
+                                          std::move(block_patterns),
+                                          base::DoNothing());
+  }
 }
 
