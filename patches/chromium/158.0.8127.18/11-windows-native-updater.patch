+def NormalizeDynamicIdlComment(contents, original_idl, generated_idl):
+    # Branding an existing .idl relocates the compiler input to gen/. Only
+    # normalize that provenance comment; declarations and GUIDs stay compared.
+    # Existing .template inputs already have gen/ paths in their baselines.
+    if not original_idl.endswith('.idl'):
+        return contents
+    generated = b'/* Compiler settings for ' + generated_idl.encode() + b':'
+    original = b'/* Compiler settings for ' + original_idl.encode() + b':'
+    return contents.replace(generated, original)
