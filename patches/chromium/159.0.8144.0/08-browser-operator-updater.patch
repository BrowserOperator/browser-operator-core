+std::optional<update_client::Configurator::CupSigningKey>
+Configurator::GetCupSigningKey() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if constexpr (std::string_view(BROWSER_OPERATOR_CUP_KEY).empty()) {
+    return std::nullopt;
+  } else {
+    auto decoded = base::Base64Decode(BROWSER_OPERATOR_CUP_KEY);
+    CHECK(decoded);
+    CHECK_GT(BROWSER_OPERATOR_CUP_KEY_VERSION, 0);
+    return update_client::Configurator::CupSigningKey{
+        BROWSER_OPERATOR_CUP_KEY_VERSION, std::move(*decoded)};
+  }
+}
